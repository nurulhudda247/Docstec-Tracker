{
  "expo": {
    "name": "Docstec Tracker",
    "slug": "docstec-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Docstec Logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.docstec.docstectracker"
    },
    "android": {
      "package": "com.docstec.docstectracker",
      "adaptiveIcon": {
        "backgroundColor": "#1B2A4A",
        "foregroundImage": "./assets/Docstec Logo.png",
        "backgroundImage": "./assets/Docstec Logo.png",
        "monochromeImage": "./assets/Docstec Logo.png"
      }
    },
    "web": {
      "favicon": "./assets/Docstec Logo.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
